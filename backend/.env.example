# Environment Configuration for SUBA - Thirukkural AI Wisdom Chatbot

# Application
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (SQLite by default for zero-friction setup, or PostgreSQL)
DATABASE_URL=sqlite:///./kurals.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/thirukkural_db

# Optional AI Providers (Leave empty to use SUBA's intelligent built-in semantic grounded engine)
# Supported: GEMINI, OPENAI, OLLAMA
AI_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
